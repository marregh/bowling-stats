# The real database never goes public. It holds 400+ named people, licence
# numbers that encode a birth date, a youth division, and raw scoresheet PNGs.
# data/sample.db is the synthetic stand-in -- see tools/make_sample_db.py.
data/*.db
data/*.db-journal
data/*.db-wal
data/*.sqlite
# ...and copies of it. "data/*.db" does not match club.db.bak-20260910, so a
# routine backup before a migration sat one `git add -A` away from publishing
# every name and licence number in the club.
data/*.bak*
data/*.backup*
data/*.db.*
!data/sample.db

# Service and collector output
logs/
*.log

# Generated exports
*.xlsx

# Secrets. The BITS collector no longer needs a key, but .env now holds the
# Discord webhook URL, which is a credential: anyone with it can post.
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
